# ARMv7 软浮点 (armv7-unknown-linux-musleabi) 交叉编译环境
# 用法: source .cargo/armv7.env
#
# 适用于刷了 FreshTomato 的 R7000 (BCM4709, Cortex-A9)。
# FreshTomato 的 Broadcom SDK 是 arm-brcm-linux-uclibcgnueabi（软浮点 EABI），
# 硬浮点 hf 二进制无法运行，因此使用 musleabi，不用 musleabihf。
# 二进制是静态 musl，不依赖固件 libc，但浮点 ABI 必须一致。

export XC_DIR="${XC_DIR:-/tmp/xc/arm-linux-musleabi-cross}"
export PATH="$XC_DIR/bin:$PATH"

export CARGO_TARGET_ARMV7_UNKNOWN_LINUX_MUSLEABI_LINKER="arm-linux-musleabi-gcc"
export CC_armv7_unknown_linux_musleabi="arm-linux-musleabi-gcc"
export CXX_armv7_unknown_linux_musleabi="arm-linux-musleabi-g++"
export AR_armv7_unknown_linux_musleabi="arm-linux-musleabi-ar"

# 纯软浮点：不生成 VFP/NEON 指令
# 若固件内核支持 VFP，可把 -mfloat-abi=soft 换成 softfp 提速
export CFLAGS_armv7_unknown_linux_musleabi="-march=armv7-a -mtune=cortex-a9 -mfloat-abi=soft"
export CXXFLAGS_armv7_unknown_linux_musleabi="-march=armv7-a -mtune=cortex-a9 -mfloat-abi=soft"
export RUSTFLAGS="-C link-arg=-s"
